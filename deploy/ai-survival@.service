# Keep the world running across reboots.
# A template unit, because it runs as a named user rather than as root:
#   sudo cp deploy/ai-survival@.service /etc/systemd/system/
#   sudo systemctl enable --now "ai-survival@$USER"
# Written as ai-survival.service instead, User=%i expands to nothing and systemd refuses to
# start the unit at all.
[Unit]
Description=AI Survival: a world that does not stop
After=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/ai-survival
Environment=WORLD_DIR=/opt/ai-survival/world
Environment=SHIFT=200000
Environment=MAP=384
Environment=FINDS=60
Environment=PUBLISH=900
ExecStart=/opt/ai-survival/deploy/run.sh
Restart=always
RestartSec=15
Nice=5

[Install]
WantedBy=multi-user.target
